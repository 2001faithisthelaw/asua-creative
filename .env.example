# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Upstash Redis (https://console.upstash.com). On Vercel, the Upstash integration
# also provides KV_REST_API_URL / KV_REST_API_TOKEN, which work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (audio and cover uploads from /admin). Added automatically when you
# connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Clerk user id of the one account allowed in /admin (user_xxx, from the Clerk dashboard → Users)
ADMIN_USER_ID=
